int fib(int n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

int main() {
    println_str("--- Fibonacci Calculator in Rosie ---");
    for (int i = 0; i <= 10; i = i + 1) {
        print_str("fib(");
        print_int(i);
        print_str(") = ");
        println_int(fib(i));
    }
    return 0;
}
